# Environment mode: development or production
TALK2DATA_ENV=development

# Database and runtime configuration paths (relative to root)
TALK2DATA_DB_PATH=browser-demo/application.sqlite
TALK2DATA_RUNTIME_CONFIG=browser-demo/runtime.json

# Gemini model selection and API key
TALK2DATA_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Production security keys (required only when TALK2DATA_ENV=production)
TALK2DATA_AUTH_SECRET=your_auth_secret_here
TALK2DATA_AUDIT_KEY=your_audit_key_here

# Optional: LangSmith observability & tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Talk2Data

