TALK2DATA_ENV=development
TALK2DATA_DB_PATH=talk2data.db
TALK2DATA_RUNTIME_CONFIG=demo/runtime.json
# Select the Gemini model available to your account. No automatic model switching.
TALK2DATA_MODEL=
