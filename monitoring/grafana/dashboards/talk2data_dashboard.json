          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "talk2data_http_requests_total",
          "legendFormat": "{{endpoint}} [{{status_code}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars"
          },
          "unit": "short"
        }
